{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow Downloader",
  "version": "1.2.0",
  "identifier": "com.stanley.flow-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flow Downloader",
        "width": 1300,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#09090b",
        "dragDropEnabled": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob:;",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Stanley",
    "externalBin": [
      "ytdlp",
      "ffmpeg",
      "deno"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "English",
          "PortugueseBR",
          "Spanish",
          "French",
          "German",
          "Italian",
          "Russian",
          "Turkish",
          "Arabic",
          "Japanese",
          "Korean",
          "SimpChinese",
          "Vietnamese"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libxcb1",
          "libxrandr2",
          "libdbus-1-3",
          "libpipewire-0.3-0 | libpipewire-0.3-0t64",
          "libwayland-client0",
          "libegl1",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "libxcb",
          "libXrandr",
          "dbus-libs",
          "pipewire-libs",
          "libwayland-client",
          "libglvnd-egl",
          "gstreamer1-plugins-good"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNDkxNkVFRUM3ODI1MDMKUldRREpYanM3aFpKYzJlVGlNTzQ0Vm11VGhJbzJsemw4a3hFajZwd3R2U3pVNXpCUjhFZXNVL2cK",
      "endpoints": [
        "https://github.com/stanley-meloo/Flow-Downloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
